# Copy to .env.local. Never commit .env.local.
# No secrets belong in this repo, git history included. Doctrine hard stop 9.

# The action on every form. Point at the real lead endpoint or a Formspree URL.
FORM_ENDPOINT=/api/lead

# LAUNCH=1 turns on the strict content audit. It is SUPPOSED to fail right now,
# with one blocker per fact Devin has not confirmed. Do not work around it.
# LAUNCH=1

# DRAFT_BADGES=1 shows the "pending Devin's confirmation" review badges next to
# unconfirmed facts. Separate from LAUNCH on purpose: a build for Devin or Logan
# to actually look at should render clean by default, with these badges opt-in
# for whoever is doing the fact-checking pass rather than on for every non-LAUNCH
# build. LAUNCH=1 still refuses to compile with pending facts regardless of this.
# DRAFT_BADGES=1
